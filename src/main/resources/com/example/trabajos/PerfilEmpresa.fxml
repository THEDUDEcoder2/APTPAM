<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="900.0" prefWidth="1539.0" style="-fx-background-color: #dce8f5;"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.trabajos.PerfilEmpresaController">
   <children>

      <!-- Título -->
      <Label alignment="CENTER" layoutX="392.0" layoutY="20.0" prefHeight="100.0" prefWidth="822.0"
             style="-fx-text-fill: #1a3a5c; -fx-font-size: 30; -fx-font-weight: bold;"
             text="PLATAFORMA DE EMPLEO TEMPORAL">
         <font><Font size="32.0" /></font>
      </Label>

      <!-- SIDEBAR IZQUIERDA -->
      <VBox alignment="TOP_CENTER" layoutX="28.0" layoutY="126.0"
            maxWidth="250.0" minWidth="250.0" prefHeight="674.0" prefWidth="250.0"
            spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 16;
                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);">
         <padding><Insets bottom="28.0" left="16.0" right="16.0" top="28.0" /></padding>
         <children>
            <Label alignment="CENTER" style="-fx-font-size: 60;" text="🏢" />

            <Label fx:id="lblNombreEmpresa" alignment="CENTER" prefWidth="218.0"
                   style="-fx-text-fill: #1a3a5c; -fx-font-size: 15; -fx-font-weight: bold;"
                   text="Nombre Empresa" wrapText="true" />

            <VBox alignment="CENTER" spacing="4"
                  style="-fx-background-color: linear-gradient(to bottom right, #1a3a5c, #3a7bd5);
                         -fx-background-radius: 12; -fx-padding: 14 10;">
               <Label style="-fx-text-fill: white; -fx-font-size: 12;" text="CALIFICACIÓN PROMEDIO" />
               <Label fx:id="lblPromedioCalificacion"
                      style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" text="—" />
               <Label fx:id="lblEstrellas"
                      style="-fx-text-fill: #f59e0b; -fx-font-size: 20;" text="☆☆☆☆☆" />
               <Label fx:id="lblTotalCalificaciones"
                      style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 11;" text="0 calificaciones" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="volverButton" onAction="#onVolver" prefHeight="45.0" prefWidth="218.0"
                    styleClass="btn-azul" text="← Volver al panel" />
         </children>
      </VBox>

      <!-- CONTENIDO CENTRAL con scroll -->
      <ScrollPane layoutX="290.0" layoutY="126.0" prefHeight="674.0" prefWidth="1220.0"
                  fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
         <content>
            <VBox spacing="20.0" style="-fx-padding: 0 0 20 0;">

               <!-- Datos empresa -->
               <VBox spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 16;
                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);">
                  <padding><Insets bottom="24.0" left="32.0" right="32.0" top="24.0" /></padding>
                  <Label style="-fx-text-fill: #1a3a5c; -fx-font-size: 17; -fx-font-weight: bold;"
                         text="🏢  Datos de la Empresa" />

                  <!-- Fila 1 -->
                  <HBox spacing="0.0">
                     <VBox spacing="5" prefWidth="280">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="RAZÓN SOCIAL" />
                        <Label fx:id="lblRazonSocial" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" wrapText="true" maxWidth="260"/>
                     </VBox>
                     <VBox spacing="5" prefWidth="200">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="RFC" />
                        <Label fx:id="lblRfc" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="5" prefWidth="200">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="TIPO DE EMPRESA" />
                        <Label fx:id="lblTipoEmpresa" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" wrapText="true" maxWidth="180"/>
                     </VBox>
                     <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="ACTIVIDAD ECONÓMICA" />
                        <Label fx:id="lblActEconomica" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" wrapText="true"/>
                     </VBox>
                  </HBox>

                  <!-- Fila 2 -->
                  <HBox spacing="0.0">
                     <VBox spacing="5" prefWidth="280">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="SECTOR" />
                        <Label fx:id="lblSector" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" wrapText="true" maxWidth="260"/>
                     </VBox>
                     <VBox spacing="5" prefWidth="300">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="CORREO ELECTRÓNICO" />
                        <Label fx:id="lblEmail" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="TELÉFONO" />
                        <Label fx:id="lblTelefono" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                  </HBox>
               </VBox>

               <!-- Ubicación -->
               <VBox spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 16;
                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);">
                  <padding><Insets bottom="24.0" left="32.0" right="32.0" top="24.0" /></padding>
                  <Label style="-fx-text-fill: #1a3a5c; -fx-font-size: 17; -fx-font-weight: bold;"
                         text="📍  Ubicación" />
                  <HBox spacing="0.0">
                     <VBox spacing="5" prefWidth="300">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="DOMICILIO" />
                        <Label fx:id="lblDomicilio" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" wrapText="true" maxWidth="280"/>
                     </VBox>
                     <VBox spacing="5" prefWidth="240">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="MUNICIPIO" />
                        <Label fx:id="lblMunicipio" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="5" prefWidth="240">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="CIUDAD" />
                        <Label fx:id="lblCiudad" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="CÓDIGO POSTAL" />
                        <Label fx:id="lblCodigoPostal" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                  </HBox>
               </VBox>

               <!-- Calificaciones recibidas -->
               <VBox spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 16;
                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);">
                  <padding><Insets bottom="24.0" left="32.0" right="32.0" top="24.0" /></padding>
                  <Label style="-fx-text-fill: #1a3a5c; -fx-font-size: 17; -fx-font-weight: bold;"
                         text="⭐  Calificaciones de Trabajadores" />
                  <VBox fx:id="calificacionesContainer" spacing="8.0">
                     <Label style="-fx-text-fill: #64748b; -fx-font-size: 13; -fx-font-style: italic;"
                            text="Cargando calificaciones..." />
                  </VBox>
               </VBox>

            </VBox>
         </content>
      </ScrollPane>

   </children>
</AnchorPane>
