            <VBox spacing="10.0" style="-fx-background-color: #f0f4fa; -fx-background-radius: 10; -fx-padding: 15;">
                <Label style="-fx-text-fill: #1a3a5c; -fx-font-size: 15; -fx-font-weight: bold;" text="📋 Define el perfil del candidato ideal" />

                <!-- Fila 1: Puesto (ComboBox) y Herramientas -->
                <HBox spacing="15.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #1a3a5c; -fx-font-weight: bold;" text="Puesto:" />
                        <ComboBox fx:id="puestoComboBox" prefWidth="250" promptText="Selecciona un puesto" styleClass="combo-form" />
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #1a3a5c; -fx-font-weight: bold;" text="Herramientas:" />
                        <TextField fx:id="herramientasField" promptText="Ej: Excel, AutoCAD" styleClass="campo-form" />
                    </VBox>
                </HBox>

                <!-- Fila 2: Todos los filtros en horizontal -->
                <HBox spacing="15.0" alignment="BOTTOM_LEFT">

                    <!-- Edad -->
                    <VBox spacing="5.0">
                        <Label style="-fx-text-fill: #1a3a5c; -fx-font-weight: bold;" text="Edad:" />
                        <HBox spacing="5.0">
                            <TextField fx:id="edadMinField" prefWidth="70" promptText="Mín" styleClass="campo-form" />
                            <Label style="-fx-text-fill: #1a3a5c;" text="-" />
                            <TextField fx:id="edadMaxField" prefWidth="70" promptText="Máx" styleClass="campo-form" />
                        </HBox>
                    </VBox>

                    <!-- Municipio -->
                    <VBox spacing="5.0">
                        <Label style="-fx-text-fill: #1a3a5c; -fx-font-weight: bold;" text="Municipio:" />
                        <ComboBox fx:id="municipioComboBox" prefWidth="150" promptText="Todos" styleClass="combo-form" />
                    </VBox>

                    <!-- Ciudad -->
                    <VBox spacing="5.0">
                        <Label style="-fx-text-fill: #1a3a5c; -fx-font-weight: bold;" text="Ciudad:" />
                        <ComboBox fx:id="ciudadComboBox" prefWidth="150" promptText="Todas" styleClass="combo-form" />
                    </VBox>

                    <!-- Idiomas -->
                    <VBox spacing="5.0">
                        <Label style="-fx-text-fill: #1a3a5c; -fx-font-weight: bold;" text="Idiomas:" />
                        <ComboBox fx:id="cantidadIdiomasComboBox" prefWidth="130" promptText="Cantidad" styleClass="combo-form" />
                        <VBox fx:id="idiomasContainer" spacing="4.0" />
                    </VBox>

                    <!-- Nivel estudio -->
                    <VBox spacing="5.0">
                        <Label style="-fx-text-fill: #1a3a5c; -fx-font-weight: bold;" text="Nivel estudio:" />
                        <ComboBox fx:id="nivelEstudioComboBox" prefWidth="140" promptText="Selecciona" styleClass="combo-form" />
                    </VBox>

                    <!-- Género -->
                    <VBox spacing="5.0">
                        <Label style="-fx-text-fill: #1a3a5c; -fx-font-weight: bold;" text="Género:" />
                        <ComboBox fx:id="generoComboBox" prefWidth="120" styleClass="combo-form" />
                    </VBox>

                    <!-- Años experiencia -->
                    <VBox spacing="5.0">
                        <Label style="-fx-text-fill: #1a3a5c; -fx-font-weight: bold;" text="Años exp:" />
                        <TextField fx:id="anosExperienciaField" prefWidth="90" promptText="Ej: 5" styleClass="campo-form" />
                    </VBox>

                </HBox>

                <!-- Botones -->
                <HBox spacing="15.0">
                    <Button fx:id="buscarMatchButton" onAction="#onBuscarMatchClick" styleClass="btn-verde" text="🎯 Buscar candidatos compatibles" />
                    <Button fx:id="limpiarButton" onAction="#onLimpiarClick" styleClass="btn-gris" text="🗑️ Limpiar criterios" />
                </HBox>
            </VBox>

            <!-- RESULTADOS - Tabla -->
            <Label style="-fx-text-fill: #1a3a5c; -fx-font-size: 16; -fx-font-weight: bold;" text="🏆 Candidatos encontrados (ordenados por compatibilidad)" />

            <TableView fx:id="resultadosTable" prefHeight="420.0" prefWidth="890.0" style="-fx-background-radius: 8; -fx-border-color: #bdc3c7; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nombreColumn" prefWidth="180" text="Candidato" />
                    <TableColumn fx:id="puntajeColumn" prefWidth="80" text="Match" />
                    <TableColumn fx:id="edadColumn" prefWidth="70" text="Edad" />
                    <TableColumn fx:id="especialidadColumn" prefWidth="150" text="Especialidad" />
                    <TableColumn fx:id="experienciaColumn" prefWidth="100" text="Experiencia" />
                    <TableColumn fx:id="ubicacionColumn" prefWidth="130" text="Ubicación" />
                    <TableColumn fx:id="accionesColumn" prefWidth="180" text="Acciones" />
                </columns>
            </TableView>

            <Label fx:id="mensajeLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;" text="Completa los criterios y haz clic en 'Buscar candidatos'" visible="false" />

        </VBox>

        <!-- TARJETA DERECHA - Información -->
        <VBox alignment="TOP_CENTER" layoutX="1274.0" layoutY="126.0" maxWidth="250.0" minWidth="250.0" prefHeight="674.0" prefWidth="250.0" spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);">
            <padding><Insets bottom="28.0" left="16.0" right="16.0" top="28.0" /></padding>
            <Label style="-fx-text-fill: #1a3a5c; -fx-font-size: 18; -fx-font-weight: bold;" text="¿Cómo funciona?" />
            <HBox alignment="TOP_LEFT" spacing="10.0">
                <Label style="-fx-text-fill: #3a7bd5; -fx-font-size: 19; -fx-font-weight: bold;" text="1" />
                <Label prefWidth="190.0" style="-fx-text-fill: #3a5070; -fx-font-size: 14;" text="Define el perfil del candidato que buscas" wrapText="true" />
            </HBox>
            <HBox alignment="TOP_LEFT" spacing="10.0">
                <Label style="-fx-text-fill: #3a7bd5; -fx-font-size: 19; -fx-font-weight: bold;" text="2" />
                <Label prefWidth="190.0" style="-fx-text-fill: #3a5070; -fx-font-size: 14;" text="Nuestro algoritmo analiza a todos los trabajadores" wrapText="true" />
            </HBox>
            <HBox alignment="TOP_LEFT" spacing="10.0">
                <Label style="-fx-text-fill: #3a7bd5; -fx-font-size: 19; -fx-font-weight: bold;" text="3" />
                <Label prefWidth="190.0" style="-fx-text-fill: #3a5070; -fx-font-size: 14;" text="Te mostramos los mejores candidatos ordenados por % de compatibilidad" wrapText="true" />
            </HBox>
            <HBox alignment="TOP_LEFT" spacing="10.0">
                <Label style="-fx-text-fill: #3a7bd5; -fx-font-size: 19; -fx-font-weight: bold;" text="4" />
                <Label prefWidth="190.0" style="-fx-text-fill: #3a5070; -fx-font-size: 14;" text="Puedes ver el perfil y enviar oferta exclusiva" wrapText="true" />
            </HBox>
            <Region VBox.vgrow="ALWAYS" />
        </VBox>

    </children>
</AnchorPane>