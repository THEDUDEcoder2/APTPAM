<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="900.0" prefWidth="1539.0"
    style="-fx-background-color: #dce8f5;"
    stylesheets="@calificacion.css"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.example.trabajos.ListaCalificacionController">
    <children>

        <!-- TÍTULO SUPERIOR -->
        <Label alignment="CENTER" layoutX="392.0" layoutY="20.0"
            prefHeight="100.0" prefWidth="822.0"
            style="-fx-text-fill: #1a3a5c; -fx-font-size: 30; -fx-font-weight: bold;"
            text="PLATAFORMA DE EMPLEO TEMPORAL">
            <font><Font size="32.0" /></font>
        </Label>

        <!-- TARJETA IZQUIERDA (sidebar) -->
        <VBox alignment="TOP_CENTER" layoutX="28.0" layoutY="126.0"
            maxWidth="250.0" minWidth="250.0" prefHeight="674.0" prefWidth="250.0"
            spacing="18.0"
            style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);">
            <padding><Insets bottom="28.0" left="16.0" right="16.0" top="28.0" /></padding>
            <children>
                <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@assets/WhatsApp_Image_2026-03-24_at_12.15.37-removebg-preview.png" />
                </ImageView>
                <Label alignment="CENTER" prefWidth="210.0"
                    style="-fx-text-fill: #1a3a5c; -fx-font-size: 17; -fx-font-weight: bold;"
                    text="Calificaciones" wrapText="true" />
                <Label alignment="CENTER" prefWidth="210.0"
                    style="-fx-text-fill: #64748b; -fx-font-size: 13;"
                    text="Selecciona a quien quieres calificar antes de continuar."
                    wrapText="true" />

                <Region VBox.vgrow="ALWAYS" />

                <Button fx:id="volverButton" onAction="#onVolver"
                    prefHeight="55.0" prefWidth="225.0"
                    styleClass="btn-volver" text="← Volver" />
            </children>
        </VBox>

        <!-- CONTENIDO CENTRAL -->
        <VBox layoutX="290.0" layoutY="126.0" prefHeight="674.0" prefWidth="1221.0" spacing="16.0"
            style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);">
            <padding><Insets bottom="28.0" left="32.0" right="32.0" top="28.0" /></padding>

            <!-- Encabezado -->
            <VBox spacing="4.0">
                <Label fx:id="tituloLabel"
                    style="-fx-text-fill: #1a3a5c; -fx-font-size: 22; -fx-font-weight: bold;"
                    text="Pendientes por calificar" />
                <Label fx:id="subtituloLabel"
                    style="-fx-text-fill: #64748b; -fx-font-size: 14;"
                    text="Selecciona para continuar" />
            </VBox>

            <!-- Separador -->
            <Region prefHeight="1.0" prefWidth="1157.0"
                style="-fx-background-color: #d0dce8;" />

            <!-- Lista scrolleable -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="listaContainer" spacing="14.0">
                        <padding><Insets bottom="8.0" top="4.0" /></padding>
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>

    </children>
</AnchorPane>
