<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="900.0" prefWidth="1539.0" style="-fx-background-color: #dce8f5;"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.trabajos.PerfilTrabajadorController">
   <children>

      <!-- Título -->
      <Label alignment="CENTER" layoutX="392.0" layoutY="20.0" prefHeight="100.0" prefWidth="822.0"
             style="-fx-text-fill: #1a3a5c; -fx-font-size: 30; -fx-font-weight: bold;"
             text="PLATAFORMA DE EMPLEO TEMPORAL">
         <font><Font size="32.0" /></font>
      </Label>

      <!-- SIDEBAR IZQUIERDA -->
      <VBox alignment="TOP_CENTER" layoutX="28.0" layoutY="126.0"
            maxWidth="250.0" minWidth="250.0" prefHeight="674.0" prefWidth="250.0"
            spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 16;
                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);">
         <padding><Insets bottom="28.0" left="16.0" right="16.0" top="28.0" /></padding>
         <children>
            <!-- Foto de perfil -->
            <VBox alignment="CENTER" spacing="10">
               <ImageView fx:id="fotoImageView" fitHeight="120.0" fitWidth="120.0"
                          pickOnBounds="true" preserveRatio="true"
                          style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.20), 8, 0, 0, 2);" />
            </VBox>

            <Label fx:id="lblNombreCompleto" alignment="CENTER" prefWidth="218.0"
                   style="-fx-text-fill: #1a3a5c; -fx-font-size: 15; -fx-font-weight: bold;"
                   text="Nombre Completo" wrapText="true" />

            <!-- Calificación promedio destacada -->
            <VBox alignment="CENTER" spacing="4"
                  style="-fx-background-color: linear-gradient(to bottom right, #1a3a5c, #3a7bd5);
                         -fx-background-radius: 12; -fx-padding: 14 10;">
               <Label style="-fx-text-fill: white; -fx-font-size: 12;" text="CALIFICACIÓN PROMEDIO" />
               <Label fx:id="lblPromedioCalificacion"
                      style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" text="—" />
               <Label fx:id="lblEstrellas"
                      style="-fx-text-fill: #f59e0b; -fx-font-size: 20;" text="☆☆☆☆☆" />
               <Label fx:id="lblTotalCalificaciones"
                      style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 11;" text="0 calificaciones" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="volverButton" onAction="#onVolver" prefHeight="45.0" prefWidth="218.0"
                    styleClass="btn-azul" text="← Volver al panel" />
         </children>
      </VBox>

      <!-- CONTENIDO CENTRAL con scroll -->
      <ScrollPane layoutX="290.0" layoutY="126.0" prefHeight="674.0" prefWidth="1220.0"
                  fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
         <content>
            <VBox spacing="20.0" style="-fx-padding: 0 0 20 0;">

               <!-- Datos personales -->
               <VBox spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 16;
                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);">
                  <padding><Insets bottom="22.0" left="28.0" right="28.0" top="22.0" /></padding>
                  <Label style="-fx-text-fill: #1a3a5c; -fx-font-size: 17; -fx-font-weight: bold;"
                         text="👤  Datos Personales" />

                  <HBox spacing="40.0">
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="CORREO ELECTRÓNICO" />
                        <Label fx:id="lblEmail" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="TELÉFONO" />
                        <Label fx:id="lblTelefono" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="FECHA DE NACIMIENTO" />
                        <Label fx:id="lblFechaNacimiento" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="GÉNERO" />
                        <Label fx:id="lblGenero" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="ESTADO CIVIL" />
                        <Label fx:id="lblEstadoCivil" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                  </HBox>

                  <HBox spacing="40.0">
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="NACIONALIDAD" />
                        <Label fx:id="lblNacionalidad" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="CURP" />
                        <Label fx:id="lblCurp" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="RFC" />
                        <Label fx:id="lblRfc" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                  </HBox>
               </VBox>

               <!-- Datos laborales -->
               <VBox spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 16;
                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);">
                  <padding><Insets bottom="22.0" left="28.0" right="28.0" top="22.0" /></padding>
                  <Label style="-fx-text-fill: #1a3a5c; -fx-font-size: 17; -fx-font-weight: bold;"
                         text="💼  Información Laboral" />
                  <HBox spacing="40.0">
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="ESPECIALIDAD" />
                        <Label fx:id="lblEspecialidad" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="NIVEL DE ESTUDIO" />
                        <Label fx:id="lblNivelEstudio" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="AÑOS DE EXPERIENCIA" />
                        <Label fx:id="lblAnosExperiencia" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="DISCAPACIDAD" />
                        <Label fx:id="lblDiscapacidad" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                  </HBox>
                  <VBox spacing="6">
                     <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="HABILIDADES" />
                     <Label fx:id="lblHabilidades" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" wrapText="true" />
                  </VBox>
                  <VBox spacing="6">
                     <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="HERRAMIENTAS / CONOCIMIENTOS" />
                     <Label fx:id="lblHerramientas" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" wrapText="true" />
                  </VBox>
                  <VBox spacing="6">
                     <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="EXPERIENCIA LABORAL" />
                     <Label fx:id="lblExperienciaLaboral" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" wrapText="true" />
                  </VBox>
               </VBox>

               <!-- Ubicación -->
               <VBox spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 16;
                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);">
                  <padding><Insets bottom="22.0" left="28.0" right="28.0" top="22.0" /></padding>
                  <Label style="-fx-text-fill: #1a3a5c; -fx-font-size: 17; -fx-font-weight: bold;"
                         text="📍  Ubicación" />
                  <HBox spacing="40.0">
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="DOMICILIO" />
                        <Label fx:id="lblDomicilio" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" wrapText="true" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="MUNICIPIO" />
                        <Label fx:id="lblMunicipio" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="CIUDAD" />
                        <Label fx:id="lblCiudad" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                     <VBox spacing="6">
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="CÓDIGO POSTAL" />
                        <Label fx:id="lblCodigoPostal" style="-fx-text-fill: #1a3a5c; -fx-font-size: 14;" text="—" />
                     </VBox>
                  </HBox>
               </VBox>

               <!-- Calificaciones recibidas -->
               <VBox spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 16;
                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);">
                  <padding><Insets bottom="22.0" left="28.0" right="28.0" top="22.0" /></padding>
                  <Label style="-fx-text-fill: #1a3a5c; -fx-font-size: 17; -fx-font-weight: bold;"
                         text="⭐  Calificaciones Recibidas" />
                  <VBox fx:id="calificacionesContainer" spacing="8.0">
                     <Label style="-fx-text-fill: #64748b; -fx-font-size: 13; -fx-font-style: italic;"
                            text="Cargando calificaciones..." />
                  </VBox>
               </VBox>

            </VBox>
         </content>
      </ScrollPane>

   </children>
</AnchorPane>
